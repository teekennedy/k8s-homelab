{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "security:openssf-scorecard"
  ],
  "bumpVersion": "patch",
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "rebaseWhen": "behind-base-branch",
  "prHourlyLimit": 12,
  "customManagers": [
    {
      "description": "Track Docker images in Dagger Go module",
      "customType": "regex",
      "managerFilePatterns": [
        ".dagger/**/*.go"
      ],
      "matchStrings": [
        "//\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)\\n[^\"]*\"[^:]+:(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "description": "Sync ArgoCD appVersion with GitHub releases",
      "customType": "regex",
      "managerFilePatterns": [
        "k8s/foundation/argocd/Chart.yaml"
      ],
      "matchStrings": [
        "appVersion:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "argoproj/argo-cd",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "Sync Jellyfin appVersion with GitHub releases",
      "customType": "regex",
      "managerFilePatterns": [
        "k8s/apps/jellyfin/Chart.yaml"
      ],
      "matchStrings": [
        "appVersion:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "jellyfin/jellyfin",
      "extractVersionTemplate": "^(?<version>.*)$"
    },
    {
      "description": "Sync Spoolman appVersion with GitHub releases",
      "customType": "regex",
      "managerFilePatterns": [
        "k8s/apps/spoolman/Chart.yaml"
      ],
      "matchStrings": [
        "appVersion:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "Donkie/Spoolman",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "Sync Crowdsec appVersion with GitHub releases",
      "customType": "regex",
      "managerFilePatterns": [
        "k8s/platform/crowdsec/Chart.yaml"
      ],
      "matchStrings": [
        "appVersion:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "crowdsecurity/crowdsec",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "Sync CloudNativePG appVersion with GitHub releases",
      "customType": "regex",
      "managerFilePatterns": [
        "k8s/foundation/cnpg-system/Chart.yaml"
      ],
      "matchStrings": [
        "appVersion:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "cloudnative-pg/cloudnative-pg",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "Sync intel-device-plugins appVersion with GitHub releases",
      "customType": "regex",
      "managerFilePatterns": [
        "k8s/foundation/intel-device-plugins-gpu/Chart.yaml"
      ],
      "matchStrings": [
        "appVersion:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "intel/intel-device-plugins-for-kubernetes",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "Sync kured appVersion with GitHub releases",
      "customType": "regex",
      "managerFilePatterns": [
        "k8s/foundation/kured/Chart.yaml"
      ],
      "matchStrings": [
        "appVersion:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubereboot/kured",
      "extractVersionTemplate": "^(?<version>.*)$"
    },
    {
      "description": "Sync longhorn appVersion with GitHub releases",
      "customType": "regex",
      "managerFilePatterns": [
        "k8s/foundation/longhorn-system/Chart.yaml"
      ],
      "matchStrings": [
        "appVersion:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "longhorn/longhorn",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "Sync node-feature-discovery appVersion with GitHub releases",
      "customType": "regex",
      "managerFilePatterns": [
        "k8s/foundation/node-feature-discovery/Chart.yaml"
      ],
      "matchStrings": [
        "appVersion:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes-sigs/node-feature-discovery",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "Sync secret-system appVersion with GitHub releases",
      "customType": "regex",
      "managerFilePatterns": [
        "k8s/foundation/secret-system/Chart.yaml"
      ],
      "matchStrings": [
        "appVersion:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "mittwald/kubernetes-secret-generator",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "Sync Forgejo appVersion and pinned image tag with Forgejo releases. Both files are matched by one manager so the two can never drift apart (the Gitea chart they replace had appVersion 1.27.0 while actually running image 1.26.1).",
      "customType": "regex",
      "managerFilePatterns": [
        "k8s/platform/forgejo/Chart.yaml",
        "k8s/platform/forgejo/values.yaml"
      ],
      "matchStrings": [
        "appVersion:\\s*\"?(?<currentValue>[^\"\\s]+)\"?",
        "image:\\s*\\n\\s*tag:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "forgejo-releases",
      "depNameTemplate": "forgejo/forgejo",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "Track pinned Grafana Drilldown app plugins in grafana.ini preinstall",
      "customType": "regex",
      "managerFilePatterns": [
        "k8s/platform/monitoring-system/values.yaml"
      ],
      "matchStrings": [
        "(?<depName>grafana-[a-z]+-app)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "custom.grafana-plugins",
      "versioningTemplate": "semver"
    }
  ],
  "customDatasources": {
    "grafana-plugins": {
      "description": "Grafana.com plugin catalog version API",
      "defaultRegistryUrlTemplate": "https://grafana.com/api/plugins/{{packageName}}/versions",
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": items.{ \"version\": version, \"releaseTimestamp\": createdAt } }"
      ]
    }
  },
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Skip FlakeHub transitive flake inputs that Renovate cannot resolve reliably",
      "matchManagers": [
        "nix"
      ],
      "matchDatasources": [
        "git-refs"
      ],
      "matchPackageNames": [
        "/^https://flakehub\\.com\\/f\\//"
      ],
      "enabled": false
    },
    {
      "description": "Group every update by the directory its package file lives in, so each project folder (helm chart, Go module, Python project, nix flake, etc.) gets a single PR. A folder holding multiple ecosystems (e.g. cmd/lab has go.mod + flake.nix + devenv.nix) is grouped together because they share the same packageFileDir. separateMajorMinor (default) still splits majors into their own PR.",
      "matchFileNames": [
        "**"
      ],
      "groupName": "{{packageFileDir}}"
    },
    {
      "description": "Root-level nix flake / devenv inputs have an empty packageFileDir; give them an explicit group name.",
      "matchFileNames": [
        "flake.nix",
        "flake.lock",
        "devenv.nix",
        "devenv.yaml",
        "devenv.lock"
      ],
      "groupName": "root"
    },
    {
      "description": "Don't apply minimumReleaseAge to jellyfin image+appVersion so they stay grouped",
      "minimumReleaseAge": "0 days",
      "matchPackageNames": [
        "ghcr.io/jellyfin/jellyfin",
        "jellyfin/jellyfin"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "alpine"
      ],
      "allowedVersions": "/^latest$/",
      "pinDigests": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "lissy93/dashy"
      ],
      "versioning": "regex:^release-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/teekennedy/prometheus-operator"
      ],
      "allowedVersions": "/^discord-webhook-file-fix$/",
      "pinDigests": true
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/lldap/lldap"
      ],
      "versioning": "regex:^(?<minor>\\d+)-(?<patch>\\d+)-(?<build>\\d+)-(?<compatibility>.*)?$"
    },
    {
      "description": "LinuxServer images: strip the -ls build suffix so Renovate matches the UPSTREAM project's release tags (via each image's sourceUrl override below) and renders its changelog. Trade-off: because the -ls revision is dropped from version comparison, LinuxServer-only rebuilds at the same upstream version no longer generate PRs.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^(?:gh|ls)cr\\.io/linuxserver//"
      ],
      "extractVersion": "^(?<version>.+)-ls\\d+$",
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:[.-]r?(?<build>\\d+))?$"
    },
    {
      "matchPackageNames": [
        "ghcr.io/jellyfin/jellyfin"
      ],
      "sourceUrl": "https://github.com/jellyfin/jellyfin",
      "versioning": "semver"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "sourceUrl": "https://github.com/Prowlarr/Prowlarr",
      "matchPackageNames": [
        "/^(?:gh|ls)cr\\.io/linuxserver/prowlarr$/"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "sourceUrl": "https://github.com/Sonarr/Sonarr",
      "matchPackageNames": [
        "/^(?:gh|ls)cr\\.io/linuxserver/sonarr$/"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "sourceUrl": "https://github.com/Radarr/Radarr",
      "matchPackageNames": [
        "/^(?:gh|ls)cr\\.io/linuxserver/radarr$/"
      ]
    },
    {
      "description": "qBittorrent (LinuxServer) uses <qbt>_v<libtorrent>-ls<n> tags on the libtorrent-2.x main track (the separate libtorrentv1-... track is excluded by the leading-digit anchor). Track only the qBittorrent version: this overrides the generic LinuxServer extractVersion/versioning above and matches qBittorrent's release-X.Y.Z upstream tags via Renovate's built-in 'release' changelog keyword. Same trade-off as the other LinuxServer images: libtorrent-only or ls-only rebuilds at the same qBittorrent version won't generate PRs.",
      "matchDatasources": [
        "docker"
      ],
      "sourceUrl": "https://github.com/qbittorrent/qBittorrent",
      "matchPackageNames": [
        "/^(?:gh|ls)cr\\.io/linuxserver/qbittorrent$/"
      ],
      "extractVersion": "^(?<version>\\d+\\.\\d+\\.\\d+)_v",
      "versioning": "semver"
    },
    {
      "description": "Forgejo releases on codeberg link out to a separate release-notes markdown doc instead of inlining notes; point changelogUrl at that doc directly.",
      "matchPackageNames": [
        "forgejo/forgejo"
      ],
      "changelogUrl": "https://codeberg.org/forgejo/forgejo/src/branch/forgejo/release-notes-published/{{newVersion}}.md",
      "sourceUrl": "https://codeberg.org/forgejo/forgejo"
    },
    {
      "description": "Automerge all non-major (minor/patch) updates.",
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "*"
      ]
    }
  ]
}
