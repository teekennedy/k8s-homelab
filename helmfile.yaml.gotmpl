environments:
  production:
    values:
      - config/gen/production/env.json
  staging:
    values:
      - config/gen/staging/env.json
  dev:
    values:
      - config/gen/dev/env.json
---
# Chart dependency repositories. Every release is a local chart, and helmfile
# builds a local chart's dependencies with `helm dependency build`, which
# refuses any HTTP(S) repository that isn't registered with helm first. OCI
# and file:// dependencies need no entry. Names are arbitrary: helm matches
# a dependency to its repository by URL.
repositories:
  - name: authelia
    url: https://charts.authelia.com
  - name: csi-driver-nfs
    url: https://raw.githubusercontent.com/kubernetes-csi/csi-driver-nfs/master/charts
  - name: csi-driver-smb
    url: https://raw.githubusercontent.com/kubernetes-csi/csi-driver-smb/master/charts
  - name: external-dns
    url: https://kubernetes-sigs.github.io/external-dns
  - name: grafana
    url: https://grafana.github.io/helm-charts
  - name: longhorn
    url: https://charts.longhorn.io
  - name: metallb
    url: https://metallb.github.io/metallb

templates:
  foundation:
    chart: 'k8s/foundation/{{`{{ .Release.Name }}`}}'
    namespace: '{{`{{ .Release.Name }}`}}'
    installedTemplate: '{{`{{ .Values | get (print "apps.foundation." .Release.Name) false }}`}}'
    labels:
      tier: foundation
    # values.yaml.gotmpl is where a chart takes values from the environment's
    # config. Most charts have none, so the lenient handler is scoped here
    # rather than set file-wide.
    missingFileHandler: Warn
    values:
      - 'k8s/foundation/{{`{{ .Release.Name }}`}}/values.yaml'
      - 'k8s/foundation/{{`{{ .Release.Name }}`}}/values.yaml.gotmpl'

  platform:
    chart: 'k8s/platform/{{`{{ .Release.Name }}`}}'
    namespace: '{{`{{ .Release.Name }}`}}'
    installedTemplate: '{{`{{ .Values | get (print "apps.platform." .Release.Name) false }}`}}'
    labels:
      tier: platform
    values:
      - 'k8s/platform/{{`{{ .Release.Name }}`}}/values.yaml'

  apps:
    chart: 'k8s/apps/{{`{{ .Release.Name }}`}}'
    namespace: '{{`{{ .Release.Name }}`}}'
    installedTemplate: '{{`{{ .Values | get (print "apps.apps." .Release.Name) false }}`}}'
    labels:
      tier: apps
    values:
      - 'k8s/apps/{{`{{ .Release.Name }}`}}/values.yaml'

# Releases opt in to a template via `inherit:` (rather than `defaultInherit`,
# which would apply a template's fields to every release in the file,
# clobbering per-release overrides — see the `namespace:` overrides below).

releases:
  # --- foundation tier ---
  - name: argocd
    inherit:
      - template: foundation
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  # cert-manager, then the issuers, then the bundles: each layer's resources
  # are validated by a webhook the layer before it serves, so they cannot
  # share a release.
  - name: cert-bundles
    namespace: cert-system
    inherit:
      - template: foundation
    needs:
      - cert-system/cert-system

  - name: cert-manager
    namespace: cert-system
    inherit:
      - template: foundation

  - name: cert-system
    inherit:
      - template: foundation
    needs:
      - cert-system/cert-manager

  - name: cnpg-system
    inherit:
      - template: foundation
    needs:
      - cert-system/cert-system

  - name: external-dns
    inherit:
      - template: foundation
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  - name: generic-cdi-plugin
    inherit:
      - template: foundation
  - name: intel-device-plugins-gpu
    inherit:
      - template: foundation
    needs:
      - node-feature-discovery/node-feature-discovery

  - name: kured
    inherit:
      - template: foundation

  - name: longhorn-system
    inherit:
      - template: foundation
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  - name: metallb
    namespace: metallb-system
    inherit:
      - template: foundation

  - name: node-feature-discovery
    inherit:
      - template: foundation
  - name: reflector
    inherit:
      - template: foundation

  - name: s3-proxy
    inherit:
      - template: foundation
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  - name: secret-system
    inherit:
      - template: foundation

  # No namespace of its own: storage classes are cluster-scoped, and this is
  # where the provisioner behind them runs.
  - name: storage-aliases
    namespace: kube-system
    inherit:
      - template: foundation

  - name: traefik
    # This application is deployed to kube-system namespace for ease of transition from the k3s packaged traefik
    namespace: kube-system
    inherit:
      - template: foundation
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  # --- platform tier ---
  - name: csi-driver-nfs
    inherit:
      - template: platform

  - name: csi-driver-smb
    inherit:
      - template: platform

  - name: dagger-engine
    inherit:
      - template: platform
    # Replaces the template's values list to add the helmfile-templated file.
    values:
      - k8s/platform/dagger-engine/values.yaml
      - k8s/platform/dagger-engine/values.yaml.gotmpl

  - name: crowdsec
    inherit:
      - template: platform
    needs:
      - secret-system/secret-system

  - name: victoria-metrics
    inherit:
      - template: platform
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  - name: auth-system
    inherit:
      - template: platform
    needs:
      - cert-system/cert-bundles
      - cert-system/cert-system
      - secret-system/secret-system
      - cnpg-system/cnpg-system

  - name: forgejo
    inherit:
      - template: platform
    needs:
      - cert-system/cert-system
      - secret-system/secret-system
      - cnpg-system/cnpg-system

  - name: monitoring-system
    inherit:
      - template: platform
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  - name: renovate
    inherit:
      - template: platform
    needs:
      - forgejo/forgejo

  - name: restic
    inherit:
      - template: platform

  - name: woodpecker
    inherit:
      - template: platform
    needs:
      - forgejo/forgejo
      - secret-system/secret-system

  # --- apps tier ---
  - name: copyparty
    inherit:
      - template: apps
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  - name: freshrss
    inherit:
      - template: apps
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  - name: gauntlet
    inherit:
      - template: apps
    needs:
      - cert-system/cert-system
      - cnpg-system/cnpg-system
      - reflector/reflector
      - s3-proxy/s3-proxy
      - secret-system/secret-system

  - name: homepage
    inherit:
      - template: apps
    needs:
      - cert-system/cert-system

  - name: jellyfin
    inherit:
      - template: apps
    needs:
      - cert-system/cert-bundles
      - cert-system/cert-system
      - secret-system/secret-system

  - name: joplin
    inherit:
      - template: apps
    needs:
      - cert-system/cert-system
      - reflector/reflector
      - cnpg-system/cnpg-system
      - s3-proxy/s3-proxy
      - auth-system/auth-system

  - name: openhands
    inherit:
      - template: apps
    needs:
      - cert-system/cert-system
      - secret-system/secret-system
      - forgejo/forgejo

  - name: redteam
    inherit:
      - template: apps
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  - name: romm
    inherit:
      - template: apps
    needs:
      - cert-system/cert-system
      - cnpg-system/cnpg-system
      - reflector/reflector
      - s3-proxy/s3-proxy
      - secret-system/secret-system

  - name: spoolman
    inherit:
      - template: apps
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  - name: syncthing
    inherit:
      - template: apps
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  - name: terraria
    inherit:
      - template: apps
    needs:
      - cert-system/cert-system
      - secret-system/secret-system
