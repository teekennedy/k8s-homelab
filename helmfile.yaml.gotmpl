environments:
  production:
    values:
      - config/gen/production/env.json
  staging:
    values:
      - config/gen/staging/env.json
  ephemeral:
    values:
      - config/gen/ephemeral/env.json
---
# Chart dependency repositories. Every release is a local chart, and helmfile
# builds a local chart's dependencies with `helm dependency build`, which
# refuses any HTTP(S) repository that isn't registered with helm first. OCI
# and file:// dependencies need no entry. Names are arbitrary: helm matches
# a dependency to its repository by URL.
repositories:
  - name: argo
    url: https://argoproj.github.io/argo-helm
  - name: authelia
    url: https://charts.authelia.com
  - name: bjw-s
    url: https://bjw-s-labs.github.io/helm-charts
  - name: cnpg
    url: https://cloudnative-pg.github.io/charts
  - name: crowdsec
    url: https://crowdsecurity.github.io/helm-charts
  - name: csi-driver-nfs
    url: https://raw.githubusercontent.com/kubernetes-csi/csi-driver-nfs/master/charts
  - name: csi-driver-smb
    url: https://raw.githubusercontent.com/kubernetes-csi/csi-driver-smb/master/charts
  - name: external-dns
    url: https://kubernetes-sigs.github.io/external-dns
  - name: grafana
    url: https://grafana.github.io/helm-charts
  - name: intel
    url: https://intel.github.io/helm-charts/
  - name: jetstack
    url: https://charts.jetstack.io
  - name: kubereboot
    url: https://kubereboot.github.io/charts
  - name: longhorn
    url: https://charts.longhorn.io
  - name: metallb
    url: https://metallb.github.io/metallb
  - name: mittwald
    url: https://helm.mittwald.de
  - name: node-feature-discovery
    url: https://kubernetes-sigs.github.io/node-feature-discovery/charts
  - name: oauth2-proxy
    url: https://oauth2-proxy.github.io/manifests
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: traefik
    url: https://traefik.github.io/charts
  - name: victoria-metrics
    url: https://victoriametrics.github.io/helm-charts/

templates:
  foundation:
    chart: 'k8s/foundation/{{`{{ .Release.Name }}`}}'
    namespace: '{{`{{ .Release.Name }}`}}'
    installedTemplate: '{{`{{ .Values | get (print "apps.foundation." .Release.Name) false }}`}}'
    labels:
      tier: foundation
    # Only the foundation template has an optional per-environment overlay
    # (k8s/foundation/*/{{`{{ .Environment.Name }}`}}.yaml, e.g. production.yaml)
    # that doesn't exist for every release, so the lenient handler is scoped
    # here rather than set file-wide.
    missingFileHandler: Warn
    values:
      - 'k8s/foundation/{{`{{ .Release.Name }}`}}/values.yaml'
      - 'k8s/foundation/{{`{{ .Release.Name }}`}}/{{`{{ .Environment.Name }}`}}.yaml'

  platform:
    chart: 'k8s/platform/{{`{{ .Release.Name }}`}}'
    namespace: '{{`{{ .Release.Name }}`}}'
    installedTemplate: '{{`{{ .Values | get (print "apps.platform." .Release.Name) false }}`}}'
    labels:
      tier: platform
    values:
      - 'k8s/platform/{{`{{ .Release.Name }}`}}/values.yaml'

  apps:
    chart: 'k8s/apps/{{`{{ .Release.Name }}`}}'
    namespace: '{{`{{ .Release.Name }}`}}'
    installedTemplate: '{{`{{ .Values | get (print "apps.apps." .Release.Name) false }}`}}'
    labels:
      tier: apps
    values:
      - 'k8s/apps/{{`{{ .Release.Name }}`}}/values.yaml'

# Releases opt in to a template via `inherit:` (rather than `defaultInherit`,
# which would apply a template's fields to every release in the file,
# clobbering per-release overrides — see the `namespace:` overrides below).

releases:
  # --- foundation tier ---
  - name: argocd
    inherit:
      - template: foundation
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  - name: cert-system
    inherit:
      - template: foundation
  - name: cnpg-system
    inherit:
      - template: foundation
    needs:
      - cert-system/cert-system

  - name: external-dns
    inherit:
      - template: foundation
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  - name: generic-cdi-plugin
    inherit:
      - template: foundation
  - name: intel-device-plugins-gpu
    inherit:
      - template: foundation
    needs:
      - node-feature-discovery/node-feature-discovery

  - name: kured
    inherit:
      - template: foundation

  - name: longhorn-system
    inherit:
      - template: foundation
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  - name: metallb
    namespace: metallb-system
    inherit:
      - template: foundation

  - name: node-feature-discovery
    inherit:
      - template: foundation
  - name: reflector
    inherit:
      - template: foundation

  - name: s3-proxy
    inherit:
      - template: foundation
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  - name: secret-system
    inherit:
      - template: foundation

  - name: traefik
    # This application is deployed to kube-system namespace for ease of transition from the k3s packaged traefik
    namespace: kube-system
    inherit:
      - template: foundation
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  # --- platform tier ---
  - name: csi-driver-nfs
    inherit:
      - template: platform

  - name: csi-driver-smb
    inherit:
      - template: platform

  - name: dagger-engine
    inherit:
      - template: platform
    # Replaces the template's values list to add the helmfile-templated file.
    values:
      - k8s/platform/dagger-engine/values.yaml
      - k8s/platform/dagger-engine/values.yaml.gotmpl

  - name: crowdsec
    inherit:
      - template: platform
    needs:
      - secret-system/secret-system

  - name: victoria-metrics
    inherit:
      - template: platform
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  - name: auth-system
    inherit:
      - template: platform
    needs:
      - cert-system/cert-system
      - secret-system/secret-system
      - cnpg-system/cnpg-system

  - name: forgejo
    inherit:
      - template: platform
    needs:
      - cert-system/cert-system
      - secret-system/secret-system
      - cnpg-system/cnpg-system

  - name: monitoring-system
    inherit:
      - template: platform
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  - name: renovate
    inherit:
      - template: platform
    needs:
      - forgejo/forgejo

  - name: woodpecker
    inherit:
      - template: platform
    needs:
      - forgejo/forgejo
      - secret-system/secret-system

  # --- apps tier ---
  - name: copyparty
    inherit:
      - template: apps
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  - name: freshrss
    inherit:
      - template: apps
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  - name: homepage
    inherit:
      - template: apps
    needs:
      - cert-system/cert-system

  - name: jellyfin
    inherit:
      - template: apps
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  - name: joplin
    inherit:
      - template: apps
    needs:
      - cert-system/cert-system
      - reflector/reflector
      - cnpg-system/cnpg-system
      - s3-proxy/s3-proxy
      - auth-system/auth-system

  - name: openhands
    inherit:
      - template: apps
    needs:
      - cert-system/cert-system
      - secret-system/secret-system
      - forgejo/forgejo

  - name: redteam
    inherit:
      - template: apps
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  - name: spoolman
    inherit:
      - template: apps
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  - name: syncthing
    inherit:
      - template: apps
    needs:
      - cert-system/cert-system
      - secret-system/secret-system

  - name: terraria
    inherit:
      - template: apps
    needs:
      - cert-system/cert-system
      - secret-system/secret-system
