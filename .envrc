eval "$(devenv direnvrc)"

watch_file \
  cmd/lab/devenv.nix \
  cmd/lab/default.nix \
  cmd/lab/gomod.json \
  devenv.lock \
  devenv.nix \
  devenv.yaml

# `use devenv` supports the same options as the `devenv shell` command.
#
# To silence the output, use `--quiet`.
#
# Example usage: use devenv --quiet --impure --option services.postgres.enable:bool true
#
# Profiles are opt-in (https://devenv.sh/profiles/). `ci` holds the toolchain
# `dagger check` needs and is the only profile the Dagger-built container gets;
# `interactive` adds the cluster/lab tooling, the kubeconfig, and the git hook.
# A local shell wants both.
use devenv --no-tui --profile ci --profile interactive
