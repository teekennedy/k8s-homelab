# Patterns to ignore when building packages.
.DS_Store
.git/
.gitignore
*.swp
*.bak
*.tmp
*.orig
*~
.idea/
.vscode/
# Local test scaffolding for files/metrics. Only server.py is templated into the
# ConfigMap, and a vendored virtualenv would otherwise be packaged.
files/metrics/.venv
files/metrics/__pycache__
files/metrics/tests/__pycache__
files/metrics/.pytest_cache
# Local test scaffolding for files/app-server; only the package, pyproject.toml
# and uv.lock are templated into the ConfigMap.
files/app-server/.venv
files/app-server/app_server/__pycache__
files/app-server/.pytest_cache
files/app-server/tests
# Likewise for files/canvas: only start.sh and patch_frontend.py are templated.
files/canvas/.venv
files/canvas/__pycache__
files/canvas/.pytest_cache
files/canvas/tests
