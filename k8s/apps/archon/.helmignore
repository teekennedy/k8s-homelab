# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Local test scaffolding for files/ci-signal. Only server.py is templated into
# the ConfigMap, and a vendored virtualenv would otherwise be packaged.
files/ci-signal/.venv
files/ci-signal/__pycache__
files/ci-signal/tests/__pycache__
files/ci-signal/.pytest_cache
