# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Python dev artefacts from files/roll-page/.
files/roll-page/.venv
files/roll-page/.pytest_cache
files/roll-page/tests
files/roll-page/pyproject.toml
files/roll-page/uv.lock
__pycache__
