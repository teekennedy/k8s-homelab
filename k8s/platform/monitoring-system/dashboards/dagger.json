    {
      "type": "timeseries",
      "title": "Check runs: executed vs cached",
      "description": "A check counts as executed when at least one exec under it ran; otherwise every exec was a cache hit (Tempo).",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "executed",
          "queryType": "traceql",
          "query": "{name = \"Container.withExec\" && span.\"dagger.io/cache.outcome\" = \"executed\"} << {span.\"dagger.io/check.name\" != nil} | count_over_time()",
          "metricsQueryType": "range",
          "limit": 50,
          "tableType": "traces"
        },
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "cached",
          "queryType": "traceql",
          "query": "{name = \"Container.withExec\" && span.\"dagger.io/cache.outcome\" = \"executed\"} !<< {span.\"dagger.io/check.name\" != nil} | count_over_time()",
          "metricsQueryType": "range",
          "limit": 50,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 80,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "executed"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Executed"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "cached"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Cached"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
