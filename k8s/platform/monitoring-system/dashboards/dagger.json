    {
      "type": "table",
      "title": "Flaky commits",
      "description": "CI runs of commits that had both a failed and a passing run.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "last_over_time(dagger_ci_runs_calls_total[$__range]) and on (vcs_ref_head_revision) (count by (vcs_ref_head_revision) (last_over_time(dagger_ci_runs_calls_total{status_code=\"STATUS_CODE_ERROR\"}[$__range])) and count by (vcs_ref_head_revision) (last_over_time(dagger_ci_runs_calls_total{status_code!=\"STATUS_CODE_ERROR\"}[$__range])))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "vcs_ref_head_revision": true,
              "cicd_pipeline_run_id": true,
              "status_code": true
            },
            "renameByName": {
              "vcs_ref_head_revision": "Commit",
              "cicd_pipeline_run_id": "Pipeline",
              "status_code": "Result"
            },
            "indexByName": {
              "vcs_ref_head_revision": 0,
              "cicd_pipeline_run_id": 1,
              "status_code": 2
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Pipeline",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Result"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "STATUS_CODE_ERROR": {
                        "text": "failed",
                        "color": "red",
                        "index": 0
                      },
                      "STATUS_CODE_OK": {
                        "text": "passed",
                        "color": "green",
                        "index": 1
                      },
                      "STATUS_CODE_UNSET": {
                        "text": "passed",
                        "color": "green",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pipeline"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open pipeline",
                    "url": "https://ci.msng.to/repos/1/pipeline/${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
