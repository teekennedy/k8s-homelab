{
  "uid": "dagger",
  "title": "Dagger",
  "description": "Dagger check and function durations, cache hit rate, CI failures and in-cluster engine resource usage. See k8s/platform/dagger-engine/README.md and docs/dagger-traces.md.",
  "tags": [
    "ci",
    "dagger"
  ],
  "editable": false,
  "schemaVersion": 41,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "check",
        "label": "Check",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traces_span_metrics_duration_seconds_count{dagger_io_check_name!=\"\"}, dagger_io_check_name)",
          "refId": "check"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "function",
        "label": "Function",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traces_span_metrics_duration_seconds_count{dagger_io_module_function_name!=\"\"}, dagger_io_module_function_name)",
          "refId": "function"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Check runs",
      "description": "Checks run in the selected range, CI and local (Tempo, at most 7 days).",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{span.\"dagger.io/check.name\" != nil} | count_over_time()",
          "metricsQueryType": "instant",
          "limit": 50,
          "tableType": "traces"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Cache hit rate",
      "description": "Share of check runs that ran no process of their own: everything they needed came from the cache. Every check also runs its module's /runtime to define the check, which doesn't count (Tempo).",
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{span.\"dagger.io/check.name\" != nil} | count_over_time()",
          "metricsQueryType": "instant",
          "limit": 50,
          "tableType": "traces",
          "hide": true
        },
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "B",
          "queryType": "traceql",
          "query": "{name = \"exec.processRun\" && span.\"wcprof.exec.argv\" != \"[\\\"/runtime\\\"]\"} << {span.\"dagger.io/check.name\" != nil} | count_over_time()",
          "metricsQueryType": "instant",
          "limit": 50,
          "tableType": "traces",
          "hide": true
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "refId": "C",
          "type": "reduce",
          "expression": "A",
          "reducer": "sum",
          "hide": true
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "refId": "D",
          "type": "reduce",
          "expression": "B",
          "reducer": "sum",
          "hide": true
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "refId": "E",
          "type": "math",
          "expression": "1 - $D / $C"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "0",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 1
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Executed check pass rate",
      "description": "Share of check runs that ran a process (cache misses) and passed. Cached runs repeat an earlier result, so they are left out (Tempo).",
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{name = \"exec.processRun\" && span.\"wcprof.exec.argv\" != \"[\\\"/runtime\\\"]\"} << {span.\"dagger.io/check.name\" != nil} | count_over_time()",
          "metricsQueryType": "instant",
          "limit": 50,
          "tableType": "traces",
          "hide": true
        },
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "B",
          "queryType": "traceql",
          "query": "{name = \"exec.processRun\" && span.\"wcprof.exec.argv\" != \"[\\\"/runtime\\\"]\"} << {span.\"dagger.io/check.name\" != nil && span.\"dagger.io/check.passed\" = false} | count_over_time()",
          "metricsQueryType": "instant",
          "limit": 50,
          "tableType": "traces",
          "hide": true
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "refId": "C",
          "type": "reduce",
          "expression": "A",
          "reducer": "sum",
          "hide": true
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "refId": "D",
          "type": "reduce",
          "expression": "B",
          "reducer": "sum",
          "hide": true
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "refId": "E",
          "type": "math",
          "expression": "1 - $D / $C"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "0",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 9,
        "y": 1
      },
      "id": 30
    },
    {
      "type": "stat",
      "title": "Failed check runs",
      "description": "Check runs that failed, CI and local (Tempo).",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{span.\"dagger.io/check.passed\" = false} | count_over_time()",
          "metricsQueryType": "instant",
          "limit": 50,
          "tableType": "traces"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "CI runs",
      "description": "`dagger check` runs in Woodpecker.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "count(count by (cicd_pipeline_run_id) (last_over_time(dagger_ci_runs_calls_total[$__range])))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "id": 5
    },
    {
      "type": "row",
      "title": "Durations",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": [],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Check duration p90 (slowest 10)",
      "description": "Wall clock of each check, cached and executed runs mixed, including time spent waiting for inputs and for work other checks started. Prometheus, 7 days. Buckets are coarse (5s, 15s, 30s, 1m, 2m, 5m, 10m), so values snap to them: a single slow run between 5m and 10m shows as 7.5m. Legend: 90th percentile of the hourly values; the table below has the exact p90 over the range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "topk(10, label_replace(histogram_quantile(0.9, sum by (le, dagger_io_check_name) (increase(traces_span_metrics_duration_seconds_bucket{dagger_io_check_name=~\"$check\"}[$__interval]))) >= 0, \"check\", \"$1\", \"dagger_io_check_name\", \"dag://\\\\?check=(.*)\"))",
          "legendFormat": "{{check}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "p90"
          ],
          "sortBy": "90th %",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1h",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Check duration p90 when executed (slowest 10)",
      "description": "Only runs where a process ran under the check, so this is the cost of a cache miss. Tempo, 7 days; quantiles come from power-of-two buckets. Legend: 90th percentile of the plotted values.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{name = \"exec.processRun\" && span.\"wcprof.exec.argv\" != \"[\\\"/runtime\\\"]\"} << {span.\"dagger.io/check.name\" != nil} | quantile_over_time(duration, .9) by (span.\"dagger.io/check.name\") | topk(10)",
          "metricsQueryType": "range",
          "limit": 50,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "p90"
          ],
          "sortBy": "90th %",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "id": 10,
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": ".*check=([^\"}]*).*",
            "renamePattern": "$1"
          }
        }
      ]
    },
    {
      "type": "histogram",
      "title": "CI run duration",
      "description": "Wall clock of each `dagger check` run in Woodpecker over the selected range, in 30s buckets (Tempo search, at most 1000 runs).",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{nestedSetParent < 0 && resource.deployment.environment.name = \"ci\" && name =~ \"dagger .*check.*\"}",
          "limit": 1000,
          "tableType": "traces"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(traceDuration|Duration)$"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "bucketSize": 30000,
        "combine": false,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      }
    },
    {
      "type": "timeseries",
      "title": "Mean check duration, long-term (slowest 10)",
      "description": "Daily mean per check from VictoriaMetrics, which keeps only _sum and _count. Widen the time range to see months.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "A",
          "expr": "topk(10, label_replace(sum by (dagger_io_check_name) (increase(traces_span_metrics_duration_seconds_sum{dagger_io_check_name=~\"$check\"}[1d])) / sum by (dagger_io_check_name) (increase(traces_span_metrics_duration_seconds_count{dagger_io_check_name=~\"$check\"}[1d])), \"check\", \"$1\", \"dagger_io_check_name\", \"dag://\\\\?check=(.*)\"))",
          "legendFormat": "{{check}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean"
          ],
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1d",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Module function self time (slowest 10)",
      "description": "Mean time in each module function's own body, e.g. toolchain setup. Check functions return a lazy container, so their work shows under the check, not here.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "topk(10, sum by (dagger_io_module_function_name) (increase(traces_span_metrics_duration_seconds_sum{dagger_io_module_function_name=~\"$function\"}[$__interval])) / sum by (dagger_io_module_function_name) (increase(traces_span_metrics_duration_seconds_count{dagger_io_module_function_name=~\"$function\"}[$__interval])))",
          "legendFormat": "{{dagger_io_module_function_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean"
          ],
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1h",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "id": 13
    },
    {
      "type": "table",
      "title": "Checks in the selected range",
      "description": "p90 and mean wall clock, runs and failures per check (Prometheus). Checks with no runs in the range are left out.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "p90",
          "expr": "label_replace(histogram_quantile(0.9, sum by (le, dagger_io_check_name) (increase(traces_span_metrics_duration_seconds_bucket{dagger_io_check_name=~\"$check\"}[$__range]))) >= 0, \"check\", \"$1\", \"dagger_io_check_name\", \"dag://\\\\?check=(.*)\")",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "mean",
          "expr": "label_replace(sum by (dagger_io_check_name) (increase(traces_span_metrics_duration_seconds_sum{dagger_io_check_name=~\"$check\"}[$__range])) / sum by (dagger_io_check_name) (increase(traces_span_metrics_duration_seconds_count{dagger_io_check_name=~\"$check\"}[$__range])), \"check\", \"$1\", \"dagger_io_check_name\", \"dag://\\\\?check=(.*)\")",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "runs",
          "expr": "label_replace(round(sum by (dagger_io_check_name) (increase(traces_span_metrics_calls_total{dagger_io_check_name=~\"$check\"}[$__range]))), \"check\", \"$1\", \"dagger_io_check_name\", \"dag://\\\\?check=(.*)\")",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "failures",
          "expr": "label_replace(round(sum by (dagger_io_check_name) (increase(traces_span_metrics_calls_total{dagger_io_check_name=~\"$check\", dagger_io_check_passed=\"false\"}[$__range]))), \"check\", \"$1\", \"dagger_io_check_name\", \"dag://\\\\?check=(.*)\")",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "dagger_io_check_name": true
            },
            "renameByName": {
              "check": "Check",
              "Value #p90": "p90",
              "Value #mean": "Mean",
              "Value #runs": "Runs",
              "Value #failures": "Failures"
            },
            "indexByName": {
              "check": 0,
              "Value #p90": 1,
              "Value #mean": 2,
              "Value #runs": 3,
              "Value #failures": 4
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "p90",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "p90|Mean"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failures"
            },
            "properties": [
              {
                "id": "noValue",
                "value": "0"
