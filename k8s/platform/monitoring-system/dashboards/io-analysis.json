{
  "uid": "io-analysis",
  "title": "IO Analysis",
  "editable": false,
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": true, "text": "default", "value": "default" },
        "refresh": 1
      },
      {
        "name": "loki",
        "type": "datasource",
        "query": "loki",
        "current": { "selected": true, "text": "default", "value": "default" },
        "refresh": 1
      },
      {
        "name": "node",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "query": "label_values(node_disk_io_time_seconds_total, instance)",
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "refresh": 2
      },
      {
        "name": "device",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "query": "label_values(node_disk_info{instance=~\"$node\", model!=\"VIRTUAL-DISK\"}, device)",
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Node IO",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Queue Depth per Device per Node",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "rate(node_disk_io_time_weighted_seconds_total{instance=~\"$node\", device=~\"$device\"}[5m]) * on(instance, device) group_left node_disk_info{model!=\"VIRTUAL-DISK\"}",
          "legendFormat": "{{instance}} {{device}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Disk Write Throughput per Device per Node",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "rate(node_disk_written_bytes_total{instance=~\"$node\", device=~\"$device\"}[5m]) * on(instance, device) group_left node_disk_info{model!=\"VIRTUAL-DISK\"}",
          "legendFormat": "{{instance}} {{device}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU iowait per Node",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "rate(node_cpu_seconds_total{mode=\"iowait\", instance=~\"$node\"}[5m])",
          "legendFormat": "{{instance}} cpu{{cpu}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Top Writers",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Top 10 Pods by Write Throughput",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "topk(10, rate(container_fs_writes_bytes_total{container!=\"\"}[5m]))",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Top 10 Pods by Write IOPS",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "topk(10, rate(container_fs_writes_total{container!=\"\"}[5m]))",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Longhorn Volumes",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Longhorn Volume Write IOPS",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "longhorn_volume_write_iops",
          "legendFormat": "{{volume}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Longhorn Volume Write Throughput",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "longhorn_volume_write_throughput",
          "legendFormat": "{{volume}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Longhorn Volume Write Latency",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "longhorn_volume_write_latency",
          "legendFormat": "{{volume}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Queue Depth Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Queue Depth Overlay (All Devices Stacked)",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 30,
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$datasource" },
          "expr": "rate(node_disk_io_time_weighted_seconds_total{instance=~\"$node\", device=~\"$device\"}[5m]) * on(instance, device) group_left node_disk_info{model!=\"VIRTUAL-DISK\"}",
          "legendFormat": "{{instance}} {{device}}"
        }
      ]
    },
    {
      "kind": "Panel",
      "spec": {
        "id": 15,
        "title": "IO Timeouts by Host",
        "description": "",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "query": {
                    "kind": "DataQuery",
                    "version": "v0",
                    "group": "loki",
                    "datasource": {
                      "name": "$loki"
                    },
                    "spec": {
                      "expr": "sum by (host) (count_over_time({job=\"dmesg\"} |= \"nvme0\" |= \"timeout\" [$__interval]))",
                      "editorMode": "code",
                      "queryType": "range",
                      "direction": "backward",
                      "legendFormat": "{{host}}"
                    }
                  },
                  "refId": "A",
                  "hidden": false
                }
              }
            ],
            "transformations": [],
            "queryOptions": {}
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "barchart",
          "version": "13.1.1",
          "spec": {
            "options": {
              "orientation": "auto",
              "xTickLabelRotation": 0,
              "xTickLabelSpacing": 0,
              "showValue": "auto",
              "stacking": "none",
              "groupWidth": 0.7,
              "barWidth": 0.97,
              "barRadius": 0,
              "fullHighlight": false,
              "tooltip": {
                "mode": "single",
                "sort": "none",
                "hideZeros": false
              },
              "legend": {
                "showLegend": true,
                "displayMode": "list",
                "placement": "bottom",
                "overflow": "ellipsis",
                "calcs": []
              }
            },
            "fieldConfig": {
              "defaults": {
                "custom": {
                  "lineWidth": 1,
                  "fillOpacity": 80,
                  "gradientMode": "none",
                  "axisPlacement": "auto",
                  "axisLabel": "",
                  "axisColorMode": "text",
                  "axisBorderShow": false,
                  "scaleDistribution": {
                    "type": "linear"
                  },
                  "axisCenteredZero": false,
                  "hideFrom": {
                    "tooltip": false,
                    "viz": false,
                    "legend": false
                  },
                  "thresholdsStyle": {
                    "mode": "off"
                  }
                },
                "color": {
                  "mode": "palette-classic"
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "green"
                    },
                    {
                      "value": 80,
                      "color": "red"
                    }
                  ]
                }
              },
              "overrides": []
            }
          }
        }
      }
    }
  ]
}
